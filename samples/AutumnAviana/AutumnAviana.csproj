<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>AutumnAviana</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    Package references only. CodeBrix.Imaging.Drawing.NoSkia (completely managed: no SkiaSharp, no native drawing
    library) draws every frame and hands it over as raw RGBA bytes; CodeBrix.Sdl3 opens the live window;
    CodeBrix.VideoProcessing pipes the frames to ffmpeg for the videos (the render option).
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.Drawing.NoSkia.ApacheLicenseForever" Version="1.0.317.314" />
    <PackageReference Include="CodeBrix.Sdl3.ZlibLicenseForever" Version="1.0.275.85" />
    <PackageReference Include="CodeBrix.VideoProcessing.MitLicenseForever" Version="1.0.312.59" />
  </ItemGroup>

  <!-- The bundled Roboto font (SIL OFL 1.1, see assets/Fonts/OFL.txt): text never comes from a system font. -->
  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Output\**" />
    <Compile Remove="Output\**" />
  </ItemGroup>

</Project>
