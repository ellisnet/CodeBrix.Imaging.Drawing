<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>VanGoghPaintingDemo</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    The same painting code as the main application (..\Shared), built against the completely managed
    CodeBrix.Imaging.Drawing.NoSkia package instead: no SkiaSharp, no native library, no window.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.Drawing.NoSkia.ApacheLicenseForever" Version="1.0.317.314" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
