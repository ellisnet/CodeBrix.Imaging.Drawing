<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      NOSKIA selects the fully managed backend in the shared (linked) test sources, exactly
      as it does in the library sources - see the CodeBrix.Imaging.Drawing.NoSkia project.
    -->
    <DefineConstants>$(DefineConstants);NOSKIA</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.164.180" />
  </ItemGroup>

  <!--
    The complete Skia-backed test suite is compiled from the SAME source files - linked,
    not copied - and runs against the managed backend, so both backends must satisfy the
    same behavioral guarantees. The type-alias file maps the SK names those sources spell
    onto the Drawing* workalike types.
  -->
  <ItemGroup>
    <Compile Include="..\CodeBrix.Imaging.Drawing.Tests\**\*.cs"
             Exclude="..\CodeBrix.Imaging.Drawing.Tests\bin\**;..\CodeBrix.Imaging.Drawing.Tests\obj\**"
             LinkBase="Shared" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\CodeBrix.Imaging.Drawing.NoSkia\NoSkiaTypeAliases.cs"
             Link="NoSkiaTypeAliases.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Imaging.Drawing.NoSkia\CodeBrix.Imaging.Drawing.NoSkia.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.Imaging.Drawing.NoSkia.Svg\CodeBrix.Imaging.Drawing.NoSkia.Svg.csproj" />
  </ItemGroup>

</Project>
