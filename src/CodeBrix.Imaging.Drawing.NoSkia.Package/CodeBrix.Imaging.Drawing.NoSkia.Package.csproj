<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PACKAGING project for CodeBrix.Imaging.Drawing.NoSkia.ApacheLicenseForever.

    The package carries TWO assemblies - CodeBrix.Imaging.Drawing.NoSkia (the managed
    drawing engine + drop-in session API) and CodeBrix.Imaging.Drawing.NoSkia.Svg (the
    vendored SVG pipeline + rasterizing backend). Because the Svg assembly references the
    core assembly, neither project can pack the pair by itself; this otherwise empty
    project references both and folds their build outputs into one package. Its own
    (empty) assembly is excluded from the package.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeNoSkiaAssembliesInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing - identical scheme to
    CodeBrix.Imaging.Drawing (see that project file for the full explanation).
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.Imaging.Drawing.NoSkia.ApacheLicenseForever</PackageId>
    <Product>CodeBrix.Imaging.Drawing.NoSkia</Product>
    <Title>CodeBrix.Imaging.Drawing.NoSkia</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A fully managed 2D drawing library with no native dependencies of any kind - everything renders in pure managed code. Provides the same drawing, painting, and highlighting API as CodeBrix.Imaging.Drawing, plus SVG rendering, working directly on in-memory pixel data. Use this instead of CodeBrix.Imaging.Drawing when you can't or don't want to bring in SkiaSharp or any other native graphics library. Never reference both packages in the same project - they define the same types under the same namespace and will conflict.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Imaging.Drawing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Imaging.Drawing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>drawing;painting;highlighting;annotation;ink;strokes;svg;rasterizer;managed;noskia;imaging;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README-NOSKIA.txt" Pack="true" PackagePath="AGENT-README.txt" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <!--
      The opt-in Skia type-name aliases. NuGet imports build\$(PackageId).props into every
      consuming project automatically; the aliases inside it only take effect when the
      consumer sets CodeBrixUseSkiaTypeNames.
    -->
    <None Include="build\*.props" Pack="true" PackagePath="build" />
  </ItemGroup>

  <!--
    The referenced projects are folded into this package (PrivateAssets keeps them from
    being emitted as package dependencies of their own); the packages the assemblies
    genuinely depend on are declared explicitly so consumers restore them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.Imaging.Drawing.NoSkia\CodeBrix.Imaging.Drawing.NoSkia.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\CodeBrix.Imaging.Drawing.NoSkia.Svg\CodeBrix.Imaging.Drawing.NoSkia.Svg.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.248.1113" />
    <PackageReference Include="CodeBrix.SvgParse.MsplLicenseForever" Version="1.0.248.1144" />
  </ItemGroup>

  <Target Name="IncludeNoSkiaAssembliesInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <!-- The two referenced projects' assemblies, but not their package dependencies -->
      <_NoSkiaPackFile Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
      <TfmSpecificPackageFile Include="@(_NoSkiaPackFile)" PackagePath="lib/$(TargetFramework)" Condition="'%(_NoSkiaPackFile.Extension)' == '.dll'" />
      <!-- Both assemblies' IntelliSense documentation, packed from the projects' build output (the .dll item above deliberately does not carry it, so each .xml is packed exactly once) -->
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\CodeBrix.Imaging.Drawing.NoSkia\bin\$(Configuration)\$(TargetFramework)\CodeBrix.Imaging.Drawing.NoSkia.xml" PackagePath="lib/$(TargetFramework)" Condition="Exists('$(MSBuildThisFileDirectory)..\CodeBrix.Imaging.Drawing.NoSkia\bin\$(Configuration)\$(TargetFramework)\CodeBrix.Imaging.Drawing.NoSkia.xml')" />
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\CodeBrix.Imaging.Drawing.NoSkia.Svg\bin\$(Configuration)\$(TargetFramework)\CodeBrix.Imaging.Drawing.NoSkia.Svg.xml" PackagePath="lib/$(TargetFramework)" Condition="Exists('$(MSBuildThisFileDirectory)..\CodeBrix.Imaging.Drawing.NoSkia.Svg\bin\$(Configuration)\$(TargetFramework)\CodeBrix.Imaging.Drawing.NoSkia.Svg.xml')" />
    </ItemGroup>
  </Target>

</Project>
