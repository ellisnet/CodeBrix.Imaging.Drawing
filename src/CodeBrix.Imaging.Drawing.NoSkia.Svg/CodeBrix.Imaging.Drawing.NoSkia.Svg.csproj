<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Imaging.Drawing.NoSkia.Svg</AssemblyName>
    <RootNamespace>CodeBrix.Imaging.Drawing.NoSkia.Svg</RootNamespace>
    <!--
      Most of this assembly is VENDORED from CodeBrix.SkiaSvg (Svg.Skia lineage) and none of
      it is exported: internalize-surface.sh (beside this file) makes every type outside the
      assembly root internal and demotes their doc comments to plain comments. What is left
      to document is the DrawingSvg facade and the font registry, all of it written here and
      all of it documented - so the documentation file is generated, and CS1591 is fixed at
      source rather than suppressed. Re-run that script after any re-vendor.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      This assembly ships INSIDE the CodeBrix.Imaging.Drawing.NoSkia.ApacheLicenseForever
      package (see that project's packaging targets); it is never packed on its own.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.SvgParse.MsplLicenseForever" Version="1.0.165.135" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.Imaging.Drawing.NoSkia\CodeBrix.Imaging.Drawing.NoSkia.csproj" />
  </ItemGroup>

</Project>
